# ---- hCluster Sentinel (web) — copy to .env.local for local dev; set the same names in Vercel ----
# All of these are SERVER-SIDE ONLY. None are prefixed NEXT_PUBLIC_, so none can reach a browser.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Supabase "anon" (public) key. Used server-side with the logged-in admin's session; RLS protects the data.
SUPABASE_ANON_KEY=
# Supabase service_role key. SECRET. Bypasses RLS. Only used in server routes (agent ingest, node admin, cron).
SUPABASE_SERVICE_ROLE_KEY=
# Random string (>= 32 chars). Protects /api/cron/evaluate (Vercel Cron sends it as a Bearer token).
#   openssl rand -hex 32
CRON_SECRET=
